    "contract_monotonicity_rule": "asserts_immutable_across_versions; payload_refinable"
  },
  "payload": {
    "title": "Node Reference Axiom",
    "out_of_scope": [
      "edge_label_registry_contents",
      "reciprocity_per_label_policy",
      "version_pinning_mechanics",
      "closure_and_traversal_query_languages",
      "impact_analysis_algorithms",
      "edge_retention_and_archival",
      "multi_edge_per_pair_constraints",
      "self_loop_per_label_policy",
      "edge_payload_schemas_beyond_three_structural_fields"
    ]
  }
}
