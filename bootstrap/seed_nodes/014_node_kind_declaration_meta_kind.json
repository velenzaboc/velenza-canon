{
  "node_kind": "node_kind_declaration",
  "contract": {
    "canonical_name": "node_kind_declaration",
    "asserts": {
      "self_recursive": true,
      "declares_per_declaration": 1,
      "uniqueness_scope": ["organization_id", "canonical_name"],
      "schema_lifecycle_and_encryption_in_contract": true,
      "registry_membership_requires_admitted_active_declaration": true
    },
    "content_schema": {
      "schema_format": "structured_field_declaration",
      "applies_to_nodes_of_kind": "node_kind_declaration",
      "required_top_level_fields": ["node_kind", "contract", "payload"],
      "node_kind_constraint": "node_kind_declaration",
      "required_contract_fields": ["canonical_name", "asserts", "content_schema", "per_kind_lifecycle", "per_kind_encryption_posture", "contract_monotonicity_rule"],
      "field_specs": {
        "canonical_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "uniqueness_scope": ["organization_id", "canonical_name"]
        },
        "asserts": {
          "type": "object",
          "min_entries": 1
        },
        "content_schema": {
          "type": "object",
          "shape": "self_described_via_this_section"
        },
        "per_kind_lifecycle": {
          "type": "object",
          "required_fields": ["status_enum", "legal_transitions", "re_admittable"],
          "optional_fields": ["terminal_status_values", "immutable_once_admitted", "single_instance", "bootstrap_kind"]
        },
        "per_kind_encryption_posture": {
          "type": "object",
          "required_fields": ["default_posture"],
          "optional_fields": ["field_postures"],
          "posture_enum": ["plaintext", "tenant_comp_encrypted"]
        },
        "contract_monotonicity_rule": {
          "type": "string"
        }
      },
      "required_payload_fields": ["title"],
      "optional_payload_fields": ["out_of_scope"]
    },
    "per_kind_lifecycle": {
      "status_enum": ["active", "superseded", "retired"],
      "legal_transitions": [
        {"from": "active", "to": "superseded"},
        {"from": "active", "to": "retired"},
        {"from": "superseded", "to": "retired"}
      ],
      "terminal_status_values": ["retired"],
      "re_admittable": true,
      "immutable_once_admitted": false,
      "single_instance": false,
      "bootstrap_kind": true
    },
    "per_kind_encryption_posture": {
      "default_posture": "plaintext",
      "field_postures": {}
    },
    "contract_monotonicity_rule": "contract_immutable_across_versions; payload_refinable_title_and_out_of_scope_only"
  },
  "payload": {
    "title": "Node Kind Declaration Meta-Kind",
    "out_of_scope": [
      "specific_node_kinds_in_registry",
      "content_schema_format_implementation_choice",
      "registry_query_languages",
      "registry_visualization_or_ui",
      "performance_and_indexing_for_kind_resolution",
      "audit_record_content_for_kind_declaration_admissions",
      "concurrent_admission_race_handling",
      "retirement_and_reactivation_patterns"
    ]
  }
}
