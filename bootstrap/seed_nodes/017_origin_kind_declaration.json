{
  "node_kind": "node_kind_declaration",
  "contract": {
    "canonical_name": "origin",
    "asserts": {
      "single_instance_per_organization": true,
      "second_instance_admission": false,
      "re_admittable_for_payload_wording": true,
      "contract_alteration_in_re_admission": false,
      "is_prose_carrier": true,
      "is_only_prose_carrying_kind": true
    },
    "content_schema": {
      "schema_format": "structured_field_declaration",
      "applies_to_nodes_of_kind": "origin",
      "required_top_level_fields": ["node_kind", "contract", "payload"],
      "node_kind_constraint": "origin",
      "required_contract_fields": ["kind_identity", "single_instance_rule", "voice_preservation_rule", "conflict_terminus_role", "contract_monotonicity_rule"],
      "required_payload_fields": ["title", "founder", "story", "role_in_conflict_resolution"],
      "field_specs": {
        "story": {
          "type": "object_or_string",
          "voice": "founder_first_person",
          "prose_permitted": true
        },
        "founder": {
          "type": "string"
        }
      }
    },
    "per_kind_lifecycle": {
      "status_enum": ["active", "superseded"],
      "legal_transitions": [{"from": "active", "to": "superseded"}],
      "terminal_status_values": ["superseded"],
      "re_admittable": true,
      "immutable_once_admitted": false,
      "single_instance": true,
      "bootstrap_kind": true
    },
    "per_kind_encryption_posture": {
      "default_posture": "plaintext",
      "field_postures": {}
    },
    "contract_monotonicity_rule": "contract_immutable_across_versions; payload_refinable_per_voice_preservation_rule"
  },
  "payload": {
    "title": "Origin Kind Declaration",
    "out_of_scope": [
      "specific_story_content",
      "translation_or_localization",
      "story_versioning_policies_beyond_contract_monotonicity",
      "audit_record_content_for_origin_admissions"
    ]
  }
}
