{
  "node_kind": "node_kind_declaration",
  "contract": {
    "canonical_name": "section",
    "asserts": {
      "structural_fields_in_contract": ["contract_monotonicity_rule"],
      "optional_contract_fields": ["canonical_name", "section_role"],
      "required_payload_fields": ["title", "body"],
      "body_shape": "structured_no_prose",
      "hierarchical_composition_via_declares_edges": true,
      "inline_parent_section_id_field": false,
      "body_encryption": "tenant_comp_encrypted",
      "title_encryption": "plaintext"
    },
    "content_schema": {
      "schema_format": "structured_field_declaration",
      "applies_to_nodes_of_kind": "section",
      "required_top_level_fields": ["node_kind", "contract", "payload"],
      "node_kind_constraint": "section",
      "required_contract_fields": ["contract_monotonicity_rule"],
      "optional_contract_fields": ["canonical_name", "section_role"],
      "required_payload_fields": ["title", "body"],
      "optional_payload_fields": ["summary", "ordering_hint"],
      "field_specs": {
        "canonical_name": {
          "type": "string_or_null",
          "pattern": "^[a-z][a-z0-9_.]*$",
          "uniqueness_scope": ["organization_id", "canonical_name"]
        },
        "section_role": {
          "type": "string_or_null"
        },
        "title": {
          "type": "string",
          "encryption": "plaintext"
        },
        "body": {
          "type": "object",
          "shape": "structured_claim_clauses_no_prose",
          "encryption": "tenant_comp_encrypted"
        },
        "summary": {
          "type": "string_or_null",
          "encryption": "plaintext"
        },
        "ordering_hint": {
          "type": "integer_or_null"
        }
      }
    },
    "per_kind_lifecycle": {
      "status_enum": ["active", "deprecated", "superseded", "retired"],
      "legal_transitions": [
        {"from": "active", "to": "deprecated"},
        {"from": "active", "to": "superseded"},
        {"from": "active", "to": "retired"},
        {"from": "deprecated", "to": "retired"},
        {"from": "superseded", "to": "retired"}
      ],
      "terminal_status_values": ["retired"],
      "re_admittable": true,
      "immutable_once_admitted": false,
      "single_instance": false,
      "bootstrap_kind": false
    },
    "per_kind_encryption_posture": {
      "default_posture": "plaintext",
      "field_postures": {
        "payload.body": "tenant_comp_encrypted"
      }
    },
    "contract_monotonicity_rule": "contract_immutable_across_versions; payload_refinable_for_title_body_summary_ordering_hint_only"
  },
  "payload": {
    "title": "Section Kind Declaration",
    "out_of_scope": [
      "body_specific_structural_format",
      "section_role_vocabulary",
      "section_ordering_algorithms_for_siblings",
      "section_discovery_search_algorithms",
      "section_retention_or_archival_policy",
      "rendering_for_human_display",
      "version_diff_algorithms",
      "audit_record_content_for_section_admissions"
    ]
  }
}
