{
  "node_kind": "node_kind_declaration",
  "contract": {
    "canonical_name": "invariant",
    "asserts": {
      "canonical_name_in_contract": true,
      "canonical_name_immutable_across_versions": true,
      "uniqueness_scope": ["organization_id", "canonical_name"],
      "statement_and_scope_in_payload_refinable": true,
      "ownership_via_declares_edges": true,
      "asserted_by_via_asserts_invariant_edges": true
    },
    "content_schema": {
      "schema_format": "structured_field_declaration",
      "applies_to_nodes_of_kind": "invariant",
      "required_top_level_fields": ["node_kind", "contract", "payload"],
      "node_kind_constraint": "invariant",
      "required_contract_fields": ["canonical_name", "contract_monotonicity_rule"],
      "required_payload_fields": ["statement", "scope_description"],
      "optional_payload_fields": ["violation_consequence", "verification_method"],
      "field_specs": {
        "canonical_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "uniqueness_scope": ["organization_id", "canonical_name"]
        },
        "statement": {
          "type": "string",
          "shape": "single_clause_no_prose"
        },
        "scope_description": {
          "type": "string",
          "shape": "single_clause_no_prose"
        },
        "violation_consequence": {
          "type": "string_or_null",
          "shape": "single_clause_no_prose"
        },
        "verification_method": {
          "type": "string_or_null",
          "shape": "single_clause_no_prose"
        }
      }
    },
    "per_kind_lifecycle": {
      "status_enum": ["active", "superseded", "retired"],
      "legal_transitions": [
        {"from": "active", "to": "superseded"},
        {"from": "active", "to": "retired"},
        {"from": "superseded", "to": "retired"}
      ],
      "terminal_status_values": ["retired"],
      "re_admittable": true,
      "immutable_once_admitted": false,
      "single_instance": false,
      "bootstrap_kind": false
    },
    "per_kind_encryption_posture": {
      "default_posture": "plaintext",
      "field_postures": {}
    },
    "contract_monotonicity_rule": "contract_immutable_across_versions; payload_refinable"
  },
  "payload": {
    "title": "Invariant Kind Declaration",
    "out_of_scope": [
      "automated_invariant_verification_mechanics",
      "invariant_violation_reporting_and_alerting",
      "invariant_strength_taxonomy",
      "cross_invariant_interaction_analysis",
      "audit_record_content_for_invariant_admissions"
    ]
  }
}
