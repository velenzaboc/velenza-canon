{
  "node_kind": "node_kind_declaration",
  "contract": {
    "canonical_name": "assumption",
    "asserts": {
      "canonical_name_in_contract": true,
      "canonical_name_immutable_across_versions": true,
      "uniqueness_scope": ["organization_id", "canonical_name"],
      "assumption_statement_and_target_authority_in_payload_refinable": true,
      "target_authority_via_references_edge_when_in_corpus": true,
      "relied_upon_via_assumes_edges": true
    },
    "content_schema": {
      "schema_format": "structured_field_declaration",
      "applies_to_nodes_of_kind": "assumption",
      "required_top_level_fields": ["node_kind", "contract", "payload"],
      "node_kind_constraint": "assumption",
      "required_contract_fields": ["canonical_name", "contract_monotonicity_rule"],
      "required_payload_fields": ["assumption_statement", "target_authority"],
      "optional_payload_fields": ["risk_if_violated", "verification_path"],
      "field_specs": {
        "canonical_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "uniqueness_scope": ["organization_id", "canonical_name"]
        },
        "assumption_statement": {
          "type": "string",
          "shape": "single_clause_no_prose"
        },
        "target_authority": {
          "type": "string_or_object",
          "shape": "stable_reference_or_short_descriptor"
        },
        "risk_if_violated": {
          "type": "string_or_null",
          "shape": "single_clause_no_prose"
        },
        "verification_path": {
          "type": "string_or_null",
          "shape": "single_clause_no_prose"
        }
      }
    },
    "per_kind_lifecycle": {
      "status_enum": ["active", "deprecated", "superseded", "retired"],
      "legal_transitions": [
        {"from": "active", "to": "deprecated"},
        {"from": "active", "to": "superseded"},
        {"from": "active", "to": "retired"},
        {"from": "deprecated", "to": "retired"},
        {"from": "superseded", "to": "retired"}
      ],
      "terminal_status_values": ["retired"],
      "re_admittable": true,
      "immutable_once_admitted": false,
      "single_instance": false,
      "bootstrap_kind": false
    },
    "per_kind_encryption_posture": {
      "default_posture": "plaintext",
      "field_postures": {}
    },
    "contract_monotonicity_rule": "contract_immutable_across_versions; payload_refinable"
  },
  "payload": {
    "title": "Assumption Kind Declaration",
    "out_of_scope": [
      "external_authority_verification",
      "assumption_violation_alerting",
      "assumption_confidence_scoring",
      "automatic_propagation_of_assumption_revocation",
      "audit_record_content_for_assumption_admissions"
    ]
  }
}
