{
  "node_kind": "node_kind_declaration",
  "contract": {
    "canonical_name": "decision",
    "asserts": {
      "canonical_name_in_contract": true,
      "canonical_name_immutable_across_versions": true,
      "uniqueness_scope": ["organization_id", "canonical_name"],
      "conflict_resolution_and_reasoning_in_payload_refinable": true,
      "affected_nodes_via_references_edges": true,
      "inline_affected_nodes_array": false
    },
    "content_schema": {
      "schema_format": "structured_field_declaration",
      "applies_to_nodes_of_kind": "decision",
      "required_top_level_fields": ["node_kind", "contract", "payload"],
      "node_kind_constraint": "decision",
      "required_contract_fields": ["canonical_name", "contract_monotonicity_rule"],
      "required_payload_fields": ["conflict", "resolution", "reasoning"],
      "optional_payload_fields": ["decision_date", "framework_factors_applied"],
      "field_specs": {
        "canonical_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "uniqueness_scope": ["organization_id", "canonical_name"]
        },
        "conflict": {
          "type": "string",
          "shape": "single_clause_no_prose"
        },
        "resolution": {
          "type": "string",
          "shape": "single_clause_no_prose"
        },
        "reasoning": {
          "type": "string",
          "shape": "single_clause_no_prose"
        },
        "decision_date": {
          "type": "timestamp_or_null"
        },
        "framework_factors_applied": {
          "type": "array_of_strings_or_null"
        }
      }
    },
    "per_kind_lifecycle": {
      "status_enum": ["active", "superseded", "retired"],
      "legal_transitions": [
        {"from": "active", "to": "superseded"},
        {"from": "active", "to": "retired"},
        {"from": "superseded", "to": "retired"}
      ],
      "terminal_status_values": ["retired"],
      "re_admittable": true,
      "immutable_once_admitted": false,
      "single_instance": false,
      "bootstrap_kind": false
    },
    "per_kind_encryption_posture": {
      "default_posture": "plaintext",
      "field_postures": {}
    },
    "contract_monotonicity_rule": "contract_immutable_across_versions; payload_refinable"
  },
  "payload": {
    "title": "Decision Kind Declaration",
    "out_of_scope": [
      "decision_approval_workflow",
      "decision_impact_analysis_automatic_propagation",
      "decision_visualization_or_design_archeology_uis",
      "framework_factors_vocabulary_beyond_first_wave",
      "audit_record_content_for_decision_admissions"
    ]
  }
}
