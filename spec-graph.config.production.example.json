      "spanner_database": "projects/example-project/instances/example-instance/databases/velenza-canon",
      "read_only": false,
      "node_table": "Circuits",
      "edge_table": "CircuitEdges",
      "admission_log_table": "ArtifactAdmissionLog"
    },
    {
      "id": "ood_graph",
      "description": "OOD-Graph-owned typed tables — documentation projection per OOD Graph Protocol",
      "spanner_database": "projects/example-project/instances/example-instance/databases/velenza-canon",
      "read_only": false,
      "snapshot_table": "OODGraphSnapshots",
