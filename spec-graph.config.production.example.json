      "read_only": false,
      "node_table": "ASG_Nodes",
      "edge_table": "ASG_Edges",
      "admission_log_table": "ArtifactAdmissionLog"
    },
    {
      "id": "code_graph",
      "description": "code-graph — source-extraction evidence; cross-referenced by stable id only",
      "spanner_database": "projects/example-project/instances/example-instance/databases/velenza-canon",
      "read_only": true
    }
  ],

