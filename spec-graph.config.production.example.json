{
  "_comment": "Production config example for spec-graph. mode=production resolves the admitter and organization_id from CallerContext; init/reset have no operational role in production (substrates are managed by declarative-infra SQL).",

  "mode": "production",
  "google_credentials": {
    "credentials_source": "application_default",
    "credentials_profile": "attached_service_account",
    "credentials_identity": "spec-graph-runtime@example-project.iam.gserviceaccount.com"
  },
  "genesis_admitter": "GENESIS",
  "listen_address": "127.0.0.1:8765",

  "embedding": {
    "provider":         "vertex_ai",
    "project":          "example-project",
    "location":         "us-central1",
    "model":            "gemini-embedding-2-preview",
    "dimensions":       3072,
    "max_text_bytes":   32768
  },

