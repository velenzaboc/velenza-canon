n value="us-south1" data-href="?rep_location=us-south1">us-south1</option>      <option value="us-west1" data-href="?rep_location=us-west1">us-west1</option>      <option value="us-west2" data-href="?rep_location=us-west2">us-west2</option>      <option value="us-west3" data-href="?rep_location=us-west3">us-west3</option>      <option value="us-west4" data-href="?rep_location=us-west4">us-west4</option>    </select>  </devsite-select> </div> <div>  <br>  <code translate="no" dir="ltr">GET https://compute.googleapis.com/compute/v1/projects/{project}/aggregated/instances</code> </div></p><p>The URLs use <a href="https://google.aip.dev/127">gRPC Transcoding</a> syntax.</p>
