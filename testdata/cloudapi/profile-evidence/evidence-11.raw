n_us/IAM/latest/UserGuide/reference_sigv-troubleshooting.html" /><meta name="keywords" content="IAM,AWS Identity and Access Management,IAM user,user,IAM group,group,IAM role,role,permission policy,trust policy,policy,access key,password,Amazon Resource Names,ARNs,IAM quotas,AWS STS quotas,VPC endpoints,SigV4,SigV4a,JSON policy elements,AWS sigv4,AWS sigv4a,AWS request signing,AWS API authentication" /><script type="application/ld+json">
